# ==============================================================================
# CẤU HÌNH — ALL-IN-ONE: CVAT + inference GPU trên CÙNG 1 VM Google Cloud
#   1 lần:            bash deploy/cloud_setup.sh
#   mỗi lần dán nhãn: bash deploy/autolabel.sh
#   export sang CVAT khác: xem 04_export_task.py / 05_import_task.py
# ==============================================================================

# ---- Google Cloud ----
GCP_PROJECT="news-crawling-480703"   # project cũ, CÓ sẵn quota GPU (không bị khóa)
GCP_ZONE="asia-southeast1-c"         # chuyển sang -c do -b hết GPU L4
VM_NAME="autolabel-gpu-c"
MACHINE_TYPE="n1-standard-8"
GPU_TYPE="nvidia-tesla-t4"           # T4 (16GB) — rẻ, đủ cho inference
GPU_COUNT=1
DISK_SIZE="100GB"
IMAGE_FAMILY="common-cu129-ubuntu-2204-nvidia-580"
IMAGE_PROJECT="deeplearning-platform-release"
USE_SPOT="false"

# ---- CVAT (cài trên chính VM này) ----
CVAT_USER="admin"
CVAT_PASS="ChangeMe_123!"            # ĐỔI mật khẩu này
CVAT_EMAIL="admin@example.com"
TASK_NAME="Auto Label 3D"

# ---- Dữ liệu (nằm cạnh code trong Cloud Shell, sẽ được đẩy lên VM) ----
DATA_DIR="$HOME/autolabel/data_day14"
